# Production LAN deployment.
SUSPECT_API_HOST=0.0.0.0
SUSPECT_API_PORT=18080
SUSPECT_DEBUG=false
SUSPECT_CORS_ORIGINS=
SUSPECT_DATA_DIR=/var/lib/suspect-interrogation
SUSPECT_DB_PATH=/var/lib/suspect-interrogation/interrogation.db
SUSPECT_LOG_DIR=/var/log/suspect-interrogation
SUSPECT_MODEL_PATH=/opt/suspect-interrogation/models
SUSPECT_WEB_DIST_DIR=/opt/suspect-interrogation/current/webapp/dist
# Obsidian Vault 单向导入源；导入后的条目落在 SQLite，断网仍可用。
SUSPECT_KNOWLEDGE_VAULT=/var/lib/suspect-interrogation/knowledge-vault
SUSPECT_MIN_FREE_MB=256
SUSPECT_SPEECH_SOCKET=/run/suspect-interrogation/speech.sock

# Trusted LAN TLS. Private keys are generated under /etc and never committed.
SUSPECT_TLS_ENABLED=true
SUSPECT_TLS_DIR=/etc/suspect-interrogation/tls
SUSPECT_TLS_LAN_IP=192.168.2.109
SUSPECT_TLS_CA_FILE=/etc/suspect-interrogation/tls/ca.crt
SUSPECT_TLS_CERT_FILE=/etc/suspect-interrogation/tls/server.crt
SUSPECT_TLS_KEY_FILE=/etc/suspect-interrogation/tls/server.key

# Production speech always uses the isolated local AF_UNIX worker.
AI_MODE=real
# RK3588 ES8323 capture is stereo; plughw safely downmixes to the 16 kHz mono worker input.
ALSA_DEVICE=plughw:1,0
SUSPECT_FUNASR_MODEL_ROOT=/opt/suspect-interrogation/models/funasr
SUSPECT_FUNASR_PYTHON=/opt/suspect-interrogation/runtime/funasr-env/bin/python
SUSPECT_ERES2NET_MODEL_DIR=/opt/suspect-interrogation/models/funasr/eres2net-large
SUSPECT_SPEAKER_BACKEND=eres2net_large
MODELSCOPE_OFFLINE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Legacy optional speaker calibration overrides. New device-calibration records in the
# database are authoritative when present.
# SUSPECT_SPEAKER_ACCEPT_THRESHOLD=<calibrated decimal 0..1>
# SUSPECT_SPEAKER_MARGIN=<calibrated decimal 0..1>

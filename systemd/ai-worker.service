[Unit]
Description=Suspect Interrogation Optional Offline AI Worker
After=local-fs.target
ConditionPathExists=/opt/suspect-interrogation/current/linux/backend

[Service]
Type=simple
User=suspect-interrogation
Group=suspect-interrogation
WorkingDirectory=/opt/suspect-interrogation/current/linux/backend
EnvironmentFile=/etc/suspect-interrogation/runtime.env
EnvironmentFile=-/etc/suspect-interrogation/ai-worker.env
Environment=SUSPECT_SPEECH_SOCKET=/run/suspect-interrogation/speech.sock
# No runtime directory declaration here on purpose: systemd GCs a declared
# directory whenever the unit stops, which would drop the bound speech.sock
# during restarts. The directory is created by
# /etc/tmpfiles.d/suspect-interrogation.conf (deploy/tmpfiles-suspect-interrogation.conf).
ExecStart=/opt/suspect-interrogation/current/scripts/ai-worker-start.sh
# Model loading on the RK3588 can exceed the 90s systemd defaults during a cold
# start, and a busy worker may linger past it while unloading; give both paths a
# generous window so a redeploy restart is not misread as a failed start.
TimeoutStartSec=300s
TimeoutStopSec=120s
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/suspect-interrogation /var/lib/suspect-interrogation /var/log/suspect-interrogation
ReadOnlyPaths=/opt/suspect-interrogation/models/funasr /opt/suspect-interrogation/runtime/funasr-env /opt/suspect-interrogation/runtime/xvector-legacy-env

[Install]
WantedBy=multi-user.target
